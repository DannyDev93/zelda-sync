#!/usr/bin/env bash
# zsync — keep Zelda save files in sync between devices through a private GitHub repo.
#
#   curl -fsSL https://raw.githubusercontent.com/DannyDev93/zelda-sync/main/zsync | bash
#   curl -fsSL https://raw.githubusercontent.com/DannyDev93/zelda-sync/main/zsync | bash -s -- --dry-run
#
# Options:
#   --dry-run       show what would happen, change nothing
#   --pick-again    forget remembered save locations and choose again
#   --yes           don't ask for confirmation (for unattended use)
#   --diagnose      search this device for anything Zelda-related and upload a report (touches no saves)
#   --help
#
# Games: Skyward Sword HD (Sky Recomp), Ocarina of Time (Ship of Harkinian), Majora's Mask
# (Zelda64Recompiled), Twilight Princess (Dusklight), Wind Waker HD (ZeldaWWHDRecomp).
# Only real save files are synced: no settings, no save states.
#
# Safety rules:
#   - nothing is ever deleted without a backup (local backups + full history in the cloud repo)
#   - a game that is running is skipped
#   - a game whose saves are not found is skipped with a warning
#   - if both this device and the cloud changed since the last sync, you are asked; without a
#     terminal to ask on, that game is skipped
#   - any network or GitHub problem stops before anything is changed

set -u -o pipefail

OWNER="DannyDev93"
SAVES_REPO="zelda-saves"
VERSION="1.4"

DATA="${XDG_DATA_HOME:-$HOME/.local/share}/zelda-sync"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/zelda-sync"
CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/zelda-sync"
REPO="$DATA/repo"
BACKUPS="$DATA/backups"
STATE="$STATE_DIR/state"
PATHS="$CONF_DIR/paths"
PRODUCT=$(cat /sys/devices/virtual/dmi/id/product_name 2>/dev/null | tr -d '\n')
case "$PRODUCT" in
	Jupiter|Galileo) DEVICE="Steam Deck" ;;
	*) DEVICE=$(hostnamectl --static 2>/dev/null); [ -n "$DEVICE" ] || DEVICE="${PRODUCT:-$(hostname 2>/dev/null || echo PC)}" ;;
esac
DEVICE="${ZSYNC_DEVICE:-$DEVICE}"
REMOTE="https://github.com/$OWNER/$SAVES_REPO.git"
TEST_REMOTE="${ZSYNC_TEST_REMOTE:-}"   # for testing only: a local git repo used instead of GitHub
DRY=0
YES=0
DIAG=0
PICK_AGAIN=0

# ---------- output ----------
if [ -t 1 ]; then B=$'\e[1m'; G=$'\e[32m'; Y=$'\e[33m'; R=$'\e[31m'; C=$'\e[36m'; N=$'\e[0m'; else B= G= Y= R= C= N=; fi
say()  { printf '%s\n' "$*"; }
ok()   { printf '  %s✓%s %s\n' "$G" "$N" "$*"; }
warn() { printf '  %s⚠ %s%s\n' "$Y" "$*" "$N"; }
skip() { warn "$@"; SKIPPED=$((SKIPPED+1)); [ -n "${id-}" ] && REASON[$id]="$*"; true; }   # warn + count it, so the summary never says "all good" falsely
err()  { printf '  %s✗ %s%s\n' "$R" "$*" "$N"; }
act()  { printf '  %s→%s %s\n' "$C" "$N" "$*"; }
die()  { printf '\n%s✗ %s%s\n\nNothing was changed.\n' "$R" "$*" "$N" >&2; exit 1; }

# Ask on the terminal even when the script itself arrives through a pipe (curl | bash).
HAS_TTY=0; { exec 3<>/dev/tty; } 2>/dev/null && HAS_TTY=1
ask() { # ask "question" -> reply in $REPLY ; returns 1 when there is no terminal
	[ $HAS_TTY = 1 ] || return 1
	printf '%s' "$1" >&3; IFS= read -r REPLY <&3 || return 1; return 0
}

# ---------- games ----------
# id | name | signature file (find -name) | how to get the save root from it | files to sync (find -name) | process regex
GAMES=(
"ss;Skyward Sword HD;wiiking2.sav;slotparent;*;^(skyrecomp|sky.?recomp.*\\.appimage)$"
"soh;Ocarina of Time (Ship of Harkinian);global.sav;dir;*;^(soh\\.elf|soh|soh.*\\.appimage)$"
"mm;Majora's Mask (2 Ship 2 Harkinian);file[123].json;twoship;*.json;^(2ship|2ship.*\\.appimage)$"
"tp;Twilight Princess (Dusklight, GameCube version);*-GZ2?-gczelda2.gci;dir;*-GZ2?-gczelda2.gci;^(dusklight|dusklight.*\\.appimage)$"
"ww;Wind Waker HD (ZeldaWWHDRecomp);cking.sav;dir;*;^(wind-waker-hd|wwhd|windwakerhd.*\\.appimage)$"
)
# Names of running programs only (program file names, never their arguments), lower-case, one per line.
running_programs() {
	local p a e
	for p in /proc/[0-9]*; do
		a=$(tr '\0' '\n' < "$p/cmdline" 2>/dev/null | head -1); a=${a##*/}
		e=$(readlink "$p/exe" 2>/dev/null); e=${e##*/}
		printf '%s\n%s\n' "$a" "$e"
	done | tr '[:upper:]' '[:lower:]' | sed '/^$/d' | sort -u
}
field() { local IFS=';' F; read -r -a F <<< "$1"; printf '%s' "${F[$(( $2 - 1 ))]}"; }   # no glob expansion

# ---------- helpers ----------
valid_root() { # valid_root mode dir : is this folder really this game's save folder?
	[ -d "$2" ] || return 1
	case "$1" in
		twoship) grep -qsE '"(newCycleSave|owlSave)"' "$2"/file[123].json ;;
		slotparent) compgen -G "$2/save_[0-9]*" >/dev/null ;;
		*) true ;;
	esac
}
need() { command -v "$1" >/dev/null 2>&1 || die "This needs '$1', which isn't installed."; }

hash_dir() { # hash_dir dir pattern -> prints hash, or "none" when there are no files
	local d="$1" p="$2" list
	[ -d "$d" ] || { echo none; return; }
	list=$(cd "$d" && find . -type f -name "$p" ! -name '.*' -print0 | sort -z | xargs -0r sha256sum)
	[ -n "$list" ] && printf '%s' "$list" | sha256sum | cut -c1-16 || echo none
}
count_files() { find "$1" -type f -name "$2" ! -name '.*' 2>/dev/null | wc -l; }
newest() { # newest modification time of the save files, human readable
	local t; t=$(find "$1" -type f -name "$2" ! -name '.*' -printf '%T@\n' 2>/dev/null | sort -n | tail -1)
	[ -n "$t" ] && date -d "@${t%.*}" '+%Y-%m-%d %H:%M' || echo "-"
}
size_kb() { du -sk "$1" 2>/dev/null | cut -f1; }

state_get() { [ -f "$STATE" ] && grep -m1 "^$1=" "$STATE" | cut -d= -f2-; true; }
state_set() { mkdir -p "$STATE_DIR"; { grep -v "^$1=" "$STATE" 2>/dev/null; echo "$1=$2"; } > "$STATE.tmp" && mv "$STATE.tmp" "$STATE"; }
path_get()  { [ -f "$PATHS" ] && grep -m1 "^$1=" "$PATHS" | cut -d= -f2-; true; }
path_set()  { mkdir -p "$CONF_DIR"; { grep -v "^$1=" "$PATHS" 2>/dev/null; echo "$1=$2"; } > "$PATHS.tmp" && mv "$PATHS.tmp" "$PATHS"; }

g() { git -C "$REPO" -c http.extraHeader="Authorization: Basic $AUTH" -c user.name="zelda-sync ($DEVICE)" \
	-c user.email="zelda-sync@users.noreply.github.com" -c advice.detachedHead=false "$@"; }

backup_local() { # backup_local game root pattern -> prints the backup file
	local id="$1" root="$2" p="$3" f; mkdir -p "$BACKUPS/$id"
	f="$BACKUPS/$id/$(date '+%Y%m%d-%H%M%S').tar.gz"
	(cd "$root" && find . -type f -name "$p" ! -name '.*' -print0 | tar --null -czf "$f" -T -) || return 1
	ls -1t "$BACKUPS/$id"/*.tar.gz 2>/dev/null | tail -n +21 | xargs -r rm -f   # keep the newest 20
	echo "$f"
}

# ---------- arguments ----------
for a in "$@"; do case "$a" in
	--dry-run|-n) DRY=1 ;;
	--pick-again) PICK_AGAIN=1 ;;
	--yes|-y) YES=1 ;;
	--diagnose) DIAG=1 ;;
	-h|--help) sed -n '2,24p' "$0" 2>/dev/null || say "zsync: --dry-run, --pick-again"; exit 0 ;;
	*) die "Unknown option: $a (use --dry-run or --pick-again)" ;;
esac; done

say "${B}Zelda save sync $VERSION${N} — device: ${B}$DEVICE${N}$([ $DRY = 1 ] && printf ' — %sDRY RUN, nothing will be changed%s' "$Y" "$N")"
say ""
for t in git sha256sum find sort xargs tar curl date du; do need "$t"; done

# one run at a time
mkdir -p "$STATE_DIR" "$DATA" "$CONF_DIR" || die "Can't create my folders in $HOME."
if command -v flock >/dev/null 2>&1; then
	exec 9>"$STATE_DIR/lock"; flock -n 9 || die "zsync is already running in another window."
fi

# ---------- token ----------
TOKEN=""
for f in "$HOME/Games/Zelda/.sync/token" "$CONF_DIR/token"; do
	[ -s "$f" ] && { TOKEN=$(tr -d '[:space:]' < "$f"); TOKEN_FILE="$f"; break; }
done
if [ -z "$TOKEN" ]; then
	say "No GitHub token on this device yet."
	[ $HAS_TTY = 1 ] || die "No token found, and no terminal to ask for it. Put it in ~/.config/zelda-sync/token"
	printf 'Paste your token (github_pat_…, it stays hidden) and press Enter: ' >&3
	stty -echo <&3 2>/dev/null; IFS= read -r TOKEN <&3; stty echo <&3 2>/dev/null; printf '\n' >&3
	TOKEN=$(printf '%s' "$TOKEN" | tr -d '[:space:]')
	[ -n "$TOKEN" ] || die "No token entered."
	TOKEN_FILE="$CONF_DIR/token"
	(umask 077; printf '%s\n' "$TOKEN" > "$TOKEN_FILE") || die "Couldn't save the token."
	ok "token saved in $TOKEN_FILE (only you can read it)"
fi
AUTH=$(printf 'x-access-token:%s' "$TOKEN" | base64 | tr -d '\n')
export GIT_TERMINAL_PROMPT=0

# ---------- cloud check (before touching anything) ----------
if [ -n "$TEST_REMOTE" ]; then REMOTE="$TEST_REMOTE"; code=200; else
code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 -H "Authorization: Bearer $TOKEN" \
	"https://api.github.com/repos/$OWNER/$SAVES_REPO") || code=000; fi
case "$code" in
	200) ;;
	000) die "Can't reach GitHub. Check the internet connection." ;;
	401) die "GitHub refused the token (expired or wrong). Make a new one and put it in $TOKEN_FILE" ;;
	403|404) die "The token can't see $OWNER/$SAVES_REPO. Check the token's repository access." ;;
	*) die "GitHub answered with an error ($code). Try again in a minute." ;;
esac

if [ ! -d "$REPO/.git" ]; then
	rm -rf "$REPO"; mkdir -p "$REPO"
	git -C "$REPO" init -q -b main 2>/dev/null || { git -C "$REPO" init -q && git -C "$REPO" checkout -q -b main; }
	g remote add origin "$REMOTE"
fi
g remote set-url origin "$REMOTE"
g fetch -q origin 2>/dev/null || die "Couldn't download from the cloud (git fetch failed)."
if g rev-parse -q --verify origin/main >/dev/null; then
	g checkout -q -B main origin/main && g reset -q --hard origin/main && g clean -qfdx || die "Couldn't prepare the cloud copy."
	CLOUD_EMPTY=0
else
	CLOUD_EMPTY=1   # brand new repo
fi
ok "connected to the cloud ($([ -n "$TEST_REMOTE" ] && echo "TEST: $TEST_REMOTE" || echo "$OWNER/$SAVES_REPO"))"

# ---------- --diagnose: report what's on this device, upload it, touch no saves ----------
if [ $DIAG = 1 ]; then
	say ""
	say "Diagnose mode: searching this device (this can take a minute)…"
	stamp=$(date '+%Y%m%d-%H%M%S'); safe=$(printf '%s' "$DEVICE" | tr -c 'A-Za-z0-9._-' '_')
	rel="diagnostics/$safe-$stamp.txt"; out="$REPO/$rel"; mkdir -p "$REPO/diagnostics"
	droots=("$HOME"); for m in /run/media/*/* /run/media/* /media/* /mnt/*; do [ -d "$m" ] && [ -r "$m" ] && case "$m" in "$HOME"*) ;; *) droots+=("$m") ;; esac; done
	{
		echo "zsync $VERSION diagnose report"
		echo "device: $DEVICE   product: $PRODUCT   user: $(id -un)   home: $HOME   date: $(date)"
		grep -E '^(PRETTY_NAME|VERSION_ID)=' /etc/os-release 2>/dev/null
		echo "searched: ${droots[*]}"
		echo
		echo "== remembered save locations (~/.config/zelda-sync/paths)"; cat "$PATHS" 2>/dev/null || echo "(none)"
		echo
		echo "== flatpak apps that look related"
		flatpak list --app --columns=application,version 2>/dev/null | grep -iE 'zelda|recomp|harkinian|soh|dusk|twilit|wwhd|wind|sky|dolphin|cemu|emudeck|ryujinx|yuzu|eden|citron' || echo "(none / flatpak not available)"
		echo
		echo "== game programs and folders (name matches)"
		find "${droots[@]}" \( -path '*/.cache' -o -path '*/steamapps/shadercache' -o -path '*/.local/share/Trash' -o -path '*/.git' -o -path "$DATA" -o -path '*/romfs' -o -path '*/exefs' -o -path '*/proc' -o -path '*/flatpak/app' -o -path '*/flatpak/runtime' -o -path '*/flatpak/repo' -o -path '*/zelda-sync/repo' -o -path '*/zelda-sync/backups' \) -prune -o \
			\( -iname '*zelda64*' -o -iname '*recomp*' -o -iname '*harkinian*' -o -iname 'soh' -o -iname 'soh.*' -o -iname '*dusklight*' -o -iname '*twilit*' \
			   -o -iname 'wwhd' -o -iname '*windwaker*' -o -iname '*wind-waker*' -o -iname '*skyrecomp*' -o -iname 'TwilitRealm' \) -print 2>/dev/null | grep -viE 'shader|pipeline|/cache/' | head -200
		echo
		echo "== possible save files (with size and date)"
		find "${droots[@]}" \( -path '*/.cache' -o -path '*/steamapps/common' -o -path '*/steamapps/shadercache' -o -path '*/.local/share/Trash' -o -path '*/.git' -o -path "$DATA" -o -path '*/romfs' -o -path '*/exefs' -o -path '*/proc' -o -path '*/flatpak/app' -o -path '*/flatpak/runtime' -o -path '*/flatpak/repo' -o -path '*/zelda-sync/repo' -o -path '*/zelda-sync/backups' \) -prune -o \
			-type f \( -iname '*gczelda*' -o -iname '*GZ2*' -o -iname '*RZD*' -o -iname 'mm.n64*' -o -iname '*.n64.*.bin' -o -iname 'wiiking*' -o -iname 'cking.sav' -o -iname '2ship2harkinian.json' -o \( -iname '*.json' -ipath '*/saves/*' \) \
			   -o -iname 'global.sav' -o -iname 'file[0-9].sav' -o -iname '*.gci' -o -iname 'MemoryCard*.raw' -o -iname '*.raw' -path '*emory*' \
			   -o \( -iname '*.sav' -o -iname '*.bin' -o -iname '*.dat' -o -iname '*.json' \) \( -ipath '*zelda64*' -o -ipath '*twilit*' -o -ipath '*dusk*' -o -ipath '*soh*' -o -ipath '*harkinian*' -o -ipath '*wwhd*' -o -ipath '*skyrecomp*' \) \) \
			-printf '%TY-%Tm-%Td %TH:%TM  %10s  %p\n' 2>/dev/null | grep -viE 'shader|pipeline|/cache/|controllerdb|gamecontrollerdb|cking_pic' | sort -k4 | head -400
		echo
		PRUNE=( \( -path '*/.cache' -o -path '*/steamapps/common' -o -path '*/steamapps/shadercache' -o -path '*/.local/share/Trash' -o -path '*/.git' -o -path "$DATA"
			-o -path '*/romfs' -o -path '*/exefs' -o -path '*/proc' -o -path '*/flatpak/app' -o -path '*/flatpak/runtime' -o -path '*/flatpak/repo'
			-o -path '*/zelda-sync/repo' -o -path '*/zelda-sync/backups' -o -path '*/.var/app/org.mozilla*' -o -path '*/.mozilla' -o -path '*/.claude' -o -path '*/htmlcache'
			-o -path '*/Steam/logs' -o -path '*/Steam/appcache' -o -path '*/Steam/depotcache' -o -path '*/steamapps/downloading' -o -path '*/compatdata/*/pfx/drive_c/windows' \) -prune -o )
		echo "== every file changed in the last 3 days (newest first)"
		find "${droots[@]}" "${PRUNE[@]}" -type f -mtime -3 -size -64M -printf '%TY-%Tm-%Td %TH:%TM  %10s  %p\n' 2>/dev/null \
			| grep -viE 'shader|pipeline|/cache|\.log$|/logs/|baloo|recently-used|kwin|plasma|akonadi|\.lock$|/Trash/|thumbnails|kactivity|\.xbel|/state/|sessionstore|\.sqlite|zelda-sync/state|/fontconfig' \
			| sort -r | head -300
		echo
		echo "== every folder called saves / save / Save, with its files"
		find "${droots[@]}" "${PRUNE[@]}" -type d \( -iname saves -o -iname save -o -iname 'card a' -o -iname 'card b' \) -print 2>/dev/null | head -60 | while IFS= read -r d; do
			echo "-- $d"; find "$d" -maxdepth 2 -type f -printf '   %TY-%Tm-%Td %TH:%TM  %10s  %P\n' 2>/dev/null | sort -r | head -25
		done
		echo
		echo "== Dusklight / 2 Ship folders (contents)"
		{ find "${droots[@]}" "${PRUNE[@]}" -type f -name '2ship2harkinian.json' -printf '%h\n' 2>/dev/null; find "${droots[@]}" "${PRUNE[@]}" -type d \( -iname 'TwilitRealm' -o -iname '2s2h' -o -iname '2ship*' \) -print 2>/dev/null; } | sort -u | head -20 | while IFS= read -r d; do
			echo "-- $d"; find "$d" -maxdepth 4 \( -iname logs -o -iname mods -o -iname mod_data -o -iname sentry \) -prune -o -type f -printf '   %TY-%Tm-%Td %TH:%TM  %10s  %P\n' 2>/dev/null | sort -r | head -60
		done
		echo
		echo "== files that are 2 Ship save files by their contents"
		find "${droots[@]}" "${PRUNE[@]}" -type f -iname '*.json' -size -4M -print0 2>/dev/null | xargs -0r grep -lE '"(newCycleSave|owlSave)"' 2>/dev/null | head -40 | while IFS= read -r f; do stat -c '   %y  %10s  %n' "$f" | cut -c1-200; done
		echo
		echo "== Steam shortcuts for these games (how they are started)"
		for f in "$HOME"/.local/share/Steam/userdata/*/config/shortcuts.vdf "$HOME"/.steam/steam/userdata/*/config/shortcuts.vdf; do
			[ -f "$f" ] || continue; echo "-- $f"
			tr -c '[:print:]' '\n' < "$f" | sed '/^$/d' | grep -i -B3 -A5 -E '2ship|dusk|harkinian|majora|twilight|zelda|sky|wind' | head -120
		done
		echo
		echo "== those games running right now (program, folder it runs in, SHIP_HOME)"
		for pr in /proc/[0-9]*; do
			a=$(tr '\0' '\n' < "$pr/cmdline" 2>/dev/null | head -1)
			case "${a,,}" in *2ship*|*dusklight*|*soh*|*skyrecomp*|*wwhd*|*wind-waker*) ;; *) continue ;; esac
			printf '   pid %s  %s\n      runs in: %s   SHIP_HOME=%s\n' "${pr##*/}" "$a" "$(readlink "$pr/cwd" 2>/dev/null)" "$(tr '\0' '\n' < "$pr/environ" 2>/dev/null | sed -n 's/^SHIP_HOME=//p')"
		done
		echo
		echo "== what zsync's normal search matches (raw)"
		find "${droots[@]}" "${PRUNE[@]}" -type f \( -name 'wiiking2.sav' -o -name 'global.sav' -o -name 'file[123].json' -o -name 'global.json' -o -name '*gczelda2*.gci' -o -name 'cking.sav' \) -printf '   %TY-%Tm-%Td %TH:%TM  %p\n' 2>/dev/null | head -60
	} > "$out" 2>&1
	n=$(grep -c . "$out")
	git -C "$REPO" add "$rel" >/dev/null 2>&1
	if g commit -q -m "Diagnose report from $DEVICE" && g push -q origin main 2>/dev/null; then
		say ""; ok "report uploaded ($n lines): GitHub $OWNER/$SAVES_REPO → $rel"
		say "     Nothing else was changed. Tell Claude it's there."
		exit 0
	else
		rm -rf "$REPO"; die "Couldn't upload the report. The report is not lost: run --diagnose again."
	fi
fi

# ---------- search for save files ----------
say ""
say "Looking for save files…"
ROOTS=("$HOME")
for m in /run/media/*/* /run/media/* /media/* /mnt/*; do
	[ -d "$m" ] && [ -r "$m" ] && case "$m" in "$HOME"*) ;; *) ROOTS+=("$m") ;; esac
done
NAMES=()
for gm in "${GAMES[@]}"; do NAMES+=(-o -name "$(field "$gm" 3)"); done
NAMES+=(-o -name '*-RZD?-gczelda2.gci')   # Wii Twilight Princess: never synced, only warned about
FOUND=$(find "${ROOTS[@]}" \
	\( -path "$DATA" -o -path '*/zelda-sync/repo' -o -path '*/zelda-sync/backups' -o -path "$HOME/Games/Zelda/_work" -o -path "$HOME/Games/Zelda/.sync" \
	   -o -path '*/.cache' -o -path '*/steamapps/common' -o -path '*/steamapps/shadercache' \
	   -o -path '*/steamapps/downloading' -o -path '*/.local/share/Trash' -o -path '*/.Trash-*' \
	   -o -path '*/.git' -o -path '*/node_modules' -o -path '*/proc' -o -path '*/lost+found' \
	   -o -path '*/romfs' -o -path '*/exefs' \) -prune \
	-o -type f \( -false "${NAMES[@]}" \) -print 2>/dev/null | sort -u)

declare -A ROOT=() REASON=()
NFOUND=0; SKIPPED=0
for gm in "${GAMES[@]}"; do
	id=$(field "$gm" 1); name=$(field "$gm" 2); sig=$(field "$gm" 3); mode=$(field "$gm" 4); pat=$(field "$gm" 5)
	cands=()
	while IFS= read -r f; do
		[ -n "$f" ] || continue
		case "$(basename "$f")" in $sig) ;; *) continue ;; esac
		d=$(dirname "$f")
		if [ "$mode" = slotparent ]; then case "$(basename "$d")" in save_[0-9]*) d=$(dirname "$d") ;; *) continue ;; esac; fi
		if [ "$mode" = twoship ]; then grep -qE '"(newCycleSave|owlSave)"' "$f" 2>/dev/null || continue; fi   # a 2 Ship save, by its contents
		cands+=("$d")
	done <<< "$FOUND"
	mapfile -t cands < <(printf '%s\n' "${cands[@]-}" | sed '/^$/d' | sort -u)   # unique, safe with spaces

	remembered=$(path_get "$id"); [ $PICK_AGAIN = 1 ] && remembered=""
	chosen=""
	if [ ${#cands[@]} -eq 0 ]; then
		if [ -n "$remembered" ] && valid_root "$mode" "$remembered"; then chosen="$remembered"   # right kind of folder, saves were deleted
		else skip "$name: no save files found on this device — skipping it. (Play it once and save, then run again.)"; continue; fi
	elif [ ${#cands[@]} -eq 1 ]; then
		chosen="${cands[0]}"
	else
		for c in "${cands[@]}"; do [ "$c" = "$remembered" ] && chosen="$c"; done
		if [ -z "$chosen" ]; then
			warn "$name: found saves in ${#cands[@]} places:"
			i=1; for c in "${cands[@]}"; do printf '      %d) %s  (last saved %s)\n' $i "$c" "$(newest "$c" "$pat")"; i=$((i+1)); done
			if ask "      Which one is the real one? [1-${#cands[@]}, Enter = skip this game]: " && [[ "$REPLY" =~ ^[0-9]+$ ]] && [ "$REPLY" -ge 1 ] && [ "$REPLY" -le ${#cands[@]} ]; then
				chosen="${cands[$((REPLY-1))]}"
			else skip "$name: skipped (no location chosen)."; continue; fi
		else
			say "  · $name: using $chosen (also found $(( ${#cands[@]} - 1 )) other location(s); run with --pick-again to change)"
		fi
	fi
	[ $DRY = 1 ] || path_set "$id" "$chosen"
	ROOT[$id]="$chosen"; NFOUND=$((NFOUND+1))
	ok "$name: $chosen"
done
while IFS= read -r f; do
	case "$(basename "$f")" in *-RZD?-gczelda2.gci)
		warn "Twilight Princess: found a save from the Wii version: $f"
		warn "   It is NOT synced and is left alone — only the GameCube version is (Wii and GameCube saves aren't compatible)."
		warn "   To sync Twilight Princess, play the GameCube disc in Dusklight on every device." ;;
	esac
done <<< "$FOUND"
[ $NFOUND -gt 0 ] || die "No save files found for any of the games on this device. Play one and save first."

# ---------- decide ----------
human() { numfmt --to=iec --suffix=B "$1" 2>/dev/null || echo "${1}B"; }
list_files() { # list_files dir pattern [nodate] : files with size (and date), at most 12 lines
	local d="$1" p="$2" nodate="${3-}" n
	n=$(count_files "$d" "$p")
	# the game's main save file first, then the rest alphabetically
	(cd "$d" && find . -type f -name "$p" ! -name '.*' -printf '%P\t%s\t%TY-%Tm-%Td %TH:%TM\n' | sort |
		awk -F'\t' -v s="${sig:-}" 'BEGIN{n=split(s,a,"")} { f=$1; sub(/.*\//,"",f); if (s!="" && f ~ glob(s)) print; else rest[++r]=$0 } END{for(i=1;i<=r;i++) print rest[i]}
		function glob(g,  r){ r=g; gsub(/\./,"\\.",r); gsub(/\*/,".*",r); gsub(/\?/,".",r); return "^" r "$" }') | head -12 |
	while IFS=$'\t' read -r f s t; do
		if [ -n "$nodate" ]; then printf '          %-34s %8s\n' "$f" "$(human "$s")"
		else printf '          %-34s %8s   %s\n' "$f" "$(human "$s")" "$t"; fi
	done
	[ "$n" -gt 12 ] && printf '          … and %d more files\n' $((n-12))
	true
}
cloud_info() { # "saved <date> on <device>" for the cloud version, or ""
	local f="$REPO/games/$1.info"
	[ -f "$f" ] && printf 'saved %s on %s' "$(sed -n 's/^saved=//p' "$f")" "$(sed -n 's/^device=//p' "$f")"
}
gname() { local gm; for gm in "${GAMES[@]}"; do [ "$(field "$gm" 1)" = "$1" ] && { name=$(field "$gm" 2); pat=$(field "$gm" 5); sig=$(field "$gm" 3); }; done; }

say ""
say "Comparing with the cloud…"
UPLOAD=(); DOWNLOAD=(); declare -A UPTODATE=()
PROCS=$(running_programs)
for gm in "${GAMES[@]}"; do
	id=$(field "$gm" 1); name=$(field "$gm" 2); pat=$(field "$gm" 5); procs=$(field "$gm" 6)
	[ -n "${ROOT[$id]-}" ] || continue
	root="${ROOT[$id]}"; cdir="$REPO/games/$id"
	L=$(hash_dir "$root" "$pat"); Cl=$(hash_dir "$cdir" "$pat"); Bs=$(state_get "$id")
	cinfo=$(cloud_info "$id")

	if grep -qE "$procs" <<< "$PROCS"; then skip "$name is running right now — close it first. Skipped."; continue; fi
	if [ "$(size_kb "$root")" -gt 102400 ]; then skip "$name: save folder is over 100 MB, that's not normal. Skipped."; continue; fi

	if [ "$L" = "$Cl" ]; then
		[ "$L" = none ] && { skip "$name: no saves here or in the cloud yet."; continue; }
		ok "$name: up to date"; UPTODATE[$id]="${cinfo:-same on both}"
		[ $DRY = 1 ] || state_set "$id" "$L"; continue
	fi
	if [ "$L" = none ]; then decision=down
	elif [ "$Cl" = none ]; then decision=up
	elif [ "$Bs" = "$Cl" ]; then decision=up
	elif [ "$Bs" = "$L" ]; then decision=down
	else
		warn "$name: changed both here and in the cloud since the last sync on this device."
		printf '      this device: last saved %s\n      cloud:       %s\n' "$(newest "$root" "$pat")" "${cinfo:-unknown}"
		if ask "      Keep which one? [h = this device / c = cloud / Enter = skip]: "; then
			case "$REPLY" in h|H) decision=up ;; c|C) decision=down ;; *) skip "$name: skipped (you chose to skip it)."; continue ;; esac
		else skip "$name: skipped (needs a decision; run zsync in a terminal)."; continue; fi
	fi
	if [ "$decision" = up ]; then act "$name: this device is newer → upload"; UPLOAD+=("$id")
	else act "$name: cloud is newer → download"; DOWNLOAD+=("$id"); fi
done

# ---------- show the plan ----------
SKIPNOTE=""; [ $SKIPPED -gt 0 ] && SKIPNOTE=" ${Y}${B}$SKIPPED game(s) skipped — see the ⚠ lines above.${N}"
if [ ${#UPLOAD[@]} -eq 0 ] && [ ${#DOWNLOAD[@]} -eq 0 ]; then
	say ""
	[ $DRY = 1 ] && say "${Y}Dry run.${N}"
	if [ $SKIPPED -eq 0 ]; then say "${G}${B}Everything is in sync. Nothing to back up.${N}"; exit 0
	else say "Nothing to transfer.$SKIPNOTE"; exit 2; fi
fi

say ""
say "${B}══════════ What will be backed up ══════════${N}"
for id in "${UPLOAD[@]-}"; do
	[ -n "$id" ] || continue; gname "$id"; root="${ROOT[$id]}"; cinfo=$(cloud_info "$id")
	say ""
	say "  ${B}$name${N}"
	say "    ${C}↑ UPLOAD${N}  this device ($DEVICE)  →  cloud (GitHub $OWNER/$SAVES_REPO)"
	say "    from: $root"
	list_files "$root" "$pat"
	if [ -n "$cinfo" ]; then say "    replaces the cloud version ($cinfo) — that one stays in the cloud history"
	else say "    the cloud has no save for this game yet"; fi
done
for id in "${DOWNLOAD[@]-}"; do
	[ -n "$id" ] || continue; gname "$id"; root="${ROOT[$id]}"; cdir="$REPO/games/$id"
	say ""
	say "  ${B}$name${N}"
	say "    ${C}↓ DOWNLOAD${N}  cloud ($(cloud_info "$id"))  →  this device ($DEVICE)"
	say "    files:"
	list_files "$cdir" "$pat" nodate
	say "    to:   $root"
	if [ "$(count_files "$root" "$pat")" -gt 0 ]; then
		say "    your current save here (last saved $(newest "$root" "$pat"), $(count_files "$root" "$pat") files) is backed up first to:"
		say "          $BACKUPS/$id/"
	fi
done
if [ ${#UPTODATE[@]} -gt 0 ]; then
	say ""; printf '  Already in sync, not touched: '
	first=1; for id in "${!UPTODATE[@]}"; do gname "$id"; [ $first = 1 ] || printf ', '; printf '%s' "$name"; first=0; done; echo
fi
[ $SKIPPED -gt 0 ] && { say ""; say "  ${Y}Skipped: $SKIPPED game(s) — see the ⚠ lines above.${N}"; }
say ""
say "${B}════════════════════════════════════════════${N}"

if [ $DRY = 1 ]; then say "${Y}Dry run: nothing was changed.${N}"; exit 0; fi
if [ $YES = 0 ]; then
	if ask "Go ahead? [y = yes / Enter = cancel]: "; then
		case "$REPLY" in y|Y|yes|YES|Yes) ;; *) say "Cancelled. Nothing was changed."; exit 0 ;; esac
	else
		say "No terminal to confirm on, so nothing was changed. (Use --yes to run without asking.)"; exit 3
	fi
fi
say ""

# ---------- downloads (cloud -> this device) ----------
FAILED=0; declare -A RESULT=()
for id in "${DOWNLOAD[@]-}"; do
	[ -n "$id" ] || continue; gname "$id"
	root="${ROOT[$id]}"; cdir="$REPO/games/$id"; want=$(hash_dir "$cdir" "$pat"); cinfo=$(cloud_info "$id")
	bk=""; oldwhen=""
	if [ "$(count_files "$root" "$pat")" -gt 0 ]; then
		oldwhen=$(newest "$root" "$pat")
		bk=$(backup_local "$id" "$root" "$pat") || { err "$name: couldn't back up the current save, so I didn't touch it."; RESULT[$id]="FAIL|couldn't make the safety backup, nothing changed"; FAILED=1; continue; }
	fi
	# replace only the save files: remove local ones the cloud doesn't have, copy the cloud's in
	(cd "$root" && find . -type f -name "$pat" ! -name '.*' -print0) | while IFS= read -r -d '' f; do
		[ -e "$cdir/$f" ] || rm -f "$root/$f"
	done
	(cd "$cdir" && find . -type f -name "$pat" ! -name '.*' -print0 | tar --null -cf - -T -) | (cd "$root" && tar -xpf -)
	sync -f "$root" 2>/dev/null || sync
	if [ "$(hash_dir "$root" "$pat")" = "$want" ]; then
		state_set "$id" "$want"; ok "$name: downloaded"
		RESULT[$id]="DOWN|$(count_files "$root" "$pat")|$cinfo|$root|$bk|$oldwhen"
	else
		err "$name: download didn't check out — putting the old save back."
		[ -n "$bk" ] && (cd "$root" && tar -xzf "$bk")
		RESULT[$id]="FAIL|download didn't check out, your old save was put back"; FAILED=1
	fi
done

# ---------- uploads (this device -> cloud) ----------
COMMIT=""
if [ ${#UPLOAD[@]} -gt 0 ]; then
	for id in "${UPLOAD[@]}"; do
		gname "$id"; root="${ROOT[$id]}"; cdir="$REPO/games/$id"
		rm -rf "$cdir"; mkdir -p "$cdir"
		(cd "$root" && find . -type f -name "$pat" ! -name '.*' -print0 | tar --null -cf - -T -) | (cd "$cdir" && tar -xf -)
		printf 'game=%s\nsaved=%s\ndevice=%s\nhash=%s\n' "$name" "$(newest "$root" "$pat")" "$DEVICE" "$(hash_dir "$cdir" "$pat")" > "$REPO/games/$id.info"
	done
	g add -A games >/dev/null 2>&1
	if g commit -q -m "$(printf 'Sync from %s: %s' "$DEVICE" "${UPLOAD[*]}")" && g push -q origin main 2>/dev/null; then
		COMMIT=$(g rev-parse HEAD 2>/dev/null)
		for id in "${UPLOAD[@]}"; do
			gname "$id"; state_set "$id" "$(hash_dir "$REPO/games/$id" "$pat")"; ok "$name: uploaded"
			RESULT[$id]="UP|$(count_files "${ROOT[$id]}" "$pat")|$(cloud_info "$id")|${ROOT[$id]}"
		done
	else
		err "Upload failed (the cloud may have changed during this sync, or the connection dropped)."
		err "Your saves on this device are untouched. Just run zsync again."
		for id in "${UPLOAD[@]}"; do RESULT[$id]="FAIL|upload failed, nothing changed on this device or in the cloud"; done
		rm -rf "$REPO"; FAILED=1   # it's only a cache of the cloud; it is downloaded fresh next run
	fi
fi

# ---------- summary ----------
say ""
say "${B}══════════ Summary — $(date '+%Y-%m-%d %H:%M') on $DEVICE ══════════${N}"
for gm in "${GAMES[@]}"; do
	id=$(field "$gm" 1); name=$(field "$gm" 2)
	if [ -n "${RESULT[$id]-}" ]; then
		IFS='|' read -r kind a b c d e <<< "${RESULT[$id]}"
		case "$kind" in
		UP)   say "  ${G}✓${N} ${B}$name${N} — backed up to the cloud"
		      say "      $a file(s) from $c"
		      say "      cloud copy: $b   (GitHub $OWNER/$SAVES_REPO)"
		      [ -n "$COMMIT" ] && [ -z "$TEST_REMOTE" ] && say "      history: https://github.com/$OWNER/$SAVES_REPO/commit/${COMMIT:0:12}" ;;
		DOWN) say "  ${G}✓${N} ${B}$name${N} — restored from the cloud"
		      say "      $a file(s), version $b"
		      say "      into: $c"
		      [ -n "$d" ] && say "      your previous save (last saved $e) is kept in: $d" ;;
		FAIL) say "  ${R}✗${N} ${B}$name${N} — $a" ;;
		esac
	elif [ -n "${UPTODATE[$id]-}" ]; then
		say "  · $name — already in sync (${UPTODATE[$id]})"
	elif [ -n "${REASON[$id]-}" ]; then
		say "  ${Y}⚠${N} $name — ${REASON[$id]#"$name"}"
	fi
done
say ""
if [ $FAILED = 1 ]; then say "${Y}${B}Finished with problems — see above. Nothing was lost.${N}"; exit 1
elif [ $SKIPPED -gt 0 ]; then say "${G}${B}Done for the rest.${N}$SKIPNOTE"; exit 2
else say "${G}${B}All done.${N}"; fi
